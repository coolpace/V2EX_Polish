{
  "name": "v2ex_polish",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "author": "LeoKu (https://github.com/Codennnn)",
  "scripts": {
    "dev": "pnpm --dir apps/extension run dev",
    "dev:firefox": "pnpm --dir apps/extension run dev:firefox",
    "typecheck": "run-p typecheck:extension typecheck:website typecheck:worker",
    "typecheck:extension": "pnpm --dir apps/extension run typecheck",
    "typecheck:website": "pnpm --dir apps/website run typecheck",
    "typecheck:worker": "pnpm --dir apps/hot-topics run typecheck",
    "verify:all": "run-s typecheck lint verify:extension",
    "verify:extension": "run-s verify:dist verify:manifest",
    "verify:dist": "pnpm --dir apps/extension run build:dist",
    "verify:build": "pnpm run verify:dist",
    "verify:manifest": "run-p verify:manifest:snapshot:chrome verify:manifest:snapshot:firefox",
    "verify:manifest:snapshot:chrome": "node scripts/verify-manifest-snapshot.mjs --target chrome",
    "verify:manifest:snapshot:firefox": "node scripts/verify-manifest-snapshot.mjs --target firefox",
    "verify:userscript": "pnpm build:userscript",
    "build": "pnpm --dir apps/extension run build",
    "build:dist": "pnpm --dir apps/extension run build:dist",
    "build:all": "pnpm run build:dist",
    "build:ext": "pnpm --dir apps/extension run build:ext",
    "build:manifest": "pnpm --dir apps/extension run build:manifest",
    "build:manifest:chrome": "pnpm --dir apps/extension run build:manifest:chrome",
    "build:manifest:firefox": "pnpm --dir apps/extension run build:manifest:firefox",
    "build:style": "pnpm --dir apps/extension run build:style",
    "build:userscript": "pnpm --dir apps/extension run build:userscript",
    "package:zip": "pnpm --dir apps/extension run package:zip",
    "pack:chrome": "pnpm --dir apps/extension run pack:chrome",
    "pack:firefox": "pnpm --dir apps/extension run pack:firefox",
    "clean": "pnpm --dir apps/extension run clean",
    "watch": "pnpm --dir apps/extension run watch",
    "watch:ext": "pnpm --dir apps/extension run watch:ext",
    "watch:style": "pnpm --dir apps/extension run watch:style",
    "website:dev": "pnpm --dir apps/website dev",
    "website:build": "pnpm --dir apps/website build",
    "website:start": "pnpm --dir apps/website start",
    "worker:dev": "pnpm --dir apps/hot-topics dev",
    "worker:check": "pnpm --dir apps/hot-topics run check",
    "worker:deploy": "pnpm --dir apps/hot-topics run deploy",
    "lint": "run-p lint:es lint:style lint:prettier",
    "lint:check": "run-p lint:check:es lint:check:style lint:check:prettier",
    "lint:check:es": "run-p lint:check:repo:es lint:check:extension:es lint:check:website:es lint:check:worker:es",
    "lint:check:repo:es": "eslint \"eslint*.js\" \"stylelint*.js\" \"scripts/**/*.{js,mjs,cjs,ts,mts,cts}\" \"tests/**/*.ts\" \"vitest.config.ts\" --no-warn-ignored",
    "lint:check:extension:es": "pnpm --dir apps/extension run lint:es:check",
    "lint:check:extension:style": "pnpm --dir apps/extension run lint:style:check",
    "lint:check:website:es": "pnpm --dir apps/website run lint:es:check",
    "lint:check:website:style": "pnpm --dir apps/website run lint:style:check",
    "lint:check:worker:es": "pnpm --dir apps/hot-topics run lint:es:check",
    "lint:check:style": "run-p lint:check:extension:style lint:check:website:style",
    "lint:check:prettier": "prettier --check \"**/*.{md,json,yml,yaml}\"",
    "lint:es": "run-p lint:repo:es lint:extension:es lint:website:es lint:worker:es",
    "lint:repo:es": "eslint \"eslint*.js\" \"stylelint*.js\" \"scripts/**/*.{js,mjs,cjs,ts,mts,cts}\" \"tests/**/*.ts\" \"vitest.config.ts\" --fix --no-warn-ignored",
    "lint:extension:es": "pnpm --dir apps/extension run lint:es",
    "lint:extension:style": "pnpm --dir apps/extension run lint:style",
    "lint:website:es": "pnpm --dir apps/website run lint:es",
    "lint:website:style": "pnpm --dir apps/website run lint:style",
    "lint:worker:es": "pnpm --dir apps/hot-topics run lint:es",
    "lint:style": "run-p lint:extension:style lint:website:style",
    "lint:prettier": "prettier --write \"**/*.{md,json,yml,yaml}\"",
    "deps": "pnpm up -r --interactive --latest",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@codennnn/tsconfig": "^1.2.1",
    "@netlify/plugin-nextjs": "^5.16.3",
    "eslint": "^10.13.0",
    "npm-run-all2": "^8.0.4",
    "prefer-code-style": "4.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "eslint": "^10.13.0"
    }
  },
  "packageManager": "pnpm@9.15.3"
}
