# 复制本文件为 `.env.local` 后填入实际值，`.env.local` 不会被提交。

# 官网赞赏列表：飞书自建应用凭证与多维表格定位信息。
# - 应用需开通「读取多维表格记录」权限（base:record:retrieve），
#   并在多维表格里把该应用添加为协作者，否则接口会返回 1254xxx/91403 错误。
# - APP_TOKEN 取多维表格 URL 中 /base/ 后面那段，TABLE_ID 取表名对应的 tbl 开头 ID。
# 未配置时 /api/donation 返回 500，赞赏列表显示为空，其余页面不受影响。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# 仅开发环境生效，用于 /api/share 拉取 V2EX 主题数据。
# - 不设置：默认代理到线上站点 https://v2p.leoku.dev
# - 设置为空字符串：直连 www.v2ex.com（要求本机可访问外网）
# - 设置为自定义地址：走该地址作为上游
# SHARE_UPSTREAM_URL=
