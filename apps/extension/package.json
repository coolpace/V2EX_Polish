{
  "name": "v2ex-polish-extension",
  "version": "2.5.2",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "author": "LeoKu (https://github.com/Codennnn)",
  "scripts": {
    "dev": "run-s build:dist && run-p watch run:chrome",
    "dev:firefox": "run-s build:dist && run-p watch run:firefox",
    "run:chrome": "web-ext run -t chromium --source-dir ./dist/chrome --chromium-profile ../../chrome-dist-profile --profile-create-if-missing --keep-profile-changes --start-url https://www.v2ex.com/",
    "run:firefox": "web-ext run --source-dir ./dist/firefox --start-url https://www.v2ex.com/ --firefox-profile=../../firefox-dist-profile --profile-create-if-missing --keep-profile-changes",
    "build": "pnpm run build:dist && pnpm run package:zip",
    "build:dist": "run-s assemble build:style output:css && run-p build:manifest build:ext output:userscript",
    "build:all": "pnpm run build:dist",
    "assemble": "bun scripts/assemble-extension.ts",
    "build:userscript": "run-s generate:userscript-style output:userscript",
    "build:ext": "run-p build:ext:chrome build:ext:firefox",
    "build:ext:chrome": "EXTENSION_TARGET=chrome tsdown --config-loader unrun --config tsdown.config.ts",
    "build:ext:firefox": "EXTENSION_TARGET=firefox tsdown --config-loader unrun --config tsdown.config.ts",
    "build:manifest": "run-p build:manifest:chrome build:manifest:firefox",
    "build:manifest:chrome": "bun scripts/build-manifest.ts --target chrome",
    "build:manifest:firefox": "bun scripts/build-manifest.ts --target firefox",
    "build:style": "run-p build:style:chrome build:style:firefox",
    "build:style:chrome": "sass src/styles:dist/chrome/css --no-source-map --style=compressed",
    "build:style:firefox": "sass src/styles:dist/firefox/css --no-source-map --style=compressed",
    "package:zip": "run-s pack:chrome pack:firefox",
    "pack:chrome": "web-ext build -s ./dist/chrome -a ./dist -o -n v2ex-polish-chrome.zip",
    "pack:firefox": "web-ext build -s ./dist/firefox -a ./dist -o -n v2ex-polish-firefox.zip",
    "output:userscript": "tsdown --config-loader unrun --config tsdown.userscript.config.ts",
    "output:css": "bun scripts/build-userscript-style.mjs",
    "generate:userscript-style": "run-s build:style:chrome output:css",
    "clean": "rimraf dist src/user-scripts/style.ts",
    "watch": "run-p watch:style watch:ext",
    "watch:ext": "run-p watch:ext:chrome watch:ext:firefox",
    "watch:ext:chrome": "EXTENSION_TARGET=chrome tsdown --config-loader unrun --config tsdown.config.ts --watch",
    "watch:ext:firefox": "EXTENSION_TARGET=firefox tsdown --config-loader unrun --config tsdown.config.ts --watch",
    "watch:style": "run-p watch:style:chrome watch:style:firefox",
    "watch:style:chrome": "pnpm run build:style:chrome --watch",
    "watch:style:firefox": "pnpm run build:style:firefox --watch",
    "lint": "run-p lint:ts lint:es lint:style",
    "lint:check": "run-p lint:ts lint:es:check lint:style:check",
    "lint:ts": "pnpm run typecheck",
    "lint:es": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mts,cts,mjs}\" \"shared/**/*.{ts,tsx}\" \"public/**/*.js\" \"tsdown.config.ts\" \"tsdown.userscript.config.ts\" --fix --no-warn-ignored",
    "lint:es:check": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mts,cts,mjs}\" \"shared/**/*.{ts,tsx}\" \"public/**/*.js\" \"tsdown.config.ts\" \"tsdown.userscript.config.ts\" --no-warn-ignored",
    "lint:style": "stylelint \"src/**/*.{css,scss}\" --fix",
    "lint:style:check": "stylelint \"src/**/*.{css,scss}\"",
    "typecheck": "run-s typecheck:runtime typecheck:tooling",
    "typecheck:runtime": "tsc -p tsconfig.runtime.json --noEmit --skipLibCheck",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "lucide": "1.61.0",
    "webext-patterns": "3.0.0"
  },
  "devDependencies": {
    "@codennnn/tsconfig": "^1.2.1",
    "@types/chrome": "^0.1.36",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/jquery": "^3.5.33",
    "@types/node": "^24.3.0",
    "bun": "^1.4.3",
    "consola": "^3.4.2",
    "npm-run-all2": "^8.0.4",
    "postcss-scss": "^4.0.9",
    "prefer-code-style": "4.0.0",
    "rimraf": "^6.1.3",
    "sass": "^1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^8.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-scss": "^7.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "unrun": "0.3.1",
    "web-ext": "^10.8.0"
  },
  "packageManager": "pnpm@9.15.3"
}
