{
  "extends": "@codennnn/tsconfig/next.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"],
      "#velite": ["./.velite"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "**/.*/", ".git"]
}
